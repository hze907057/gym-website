---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

const offers = [
  {
    icon: '🏋️',
    title: 'Weights & strength',
    titleKm: 'លើកទម្ងន់ និងកម្លាំង',
    text: 'Machines and free weights, with a coach to show you good form.',
    textKm: 'ម៉ាស៊ីន និងទម្ងន់ ជាមួយគ្រូបង្វឹកដែលបង្ហាញអ្នកពីរបៀបធ្វើឱ្យត្រឹមត្រូវ។',
  },
  {
    icon: '🏊',
    title: 'Swimming pool',
    titleKm: 'អាងហែលទឹក',
    text: 'A clean pool for laps, lessons, and easy exercise for your joints.',
    textKm: 'អាងហែលទឹកស្អាត សម្រាប់ហែលទឹក រៀនហែល និងហាត់ប្រាណស្រាលៗសម្រាប់សន្លាក់។',
  },
  {
    icon: '❤️',
    title: 'Heart-rate training',
    titleKm: 'ការហាត់តាមចង្វាក់បេះដូង',
    text: 'Wear a heart-rate monitor and train in the right zone for your goal.',
    textKm: 'ពាក់ឧបករណ៍វាស់ចង្វាក់បេះដូង ហើយហាត់ក្នុងកម្រិតដែលត្រូវនឹងគោលដៅរបស់អ្នក។',
  },
  {
    icon: '🙋',
    title: 'Beginner classes',
    titleKm: 'ថ្នាក់សម្រាប់អ្នកចាប់ផ្តើម',
    text: 'Never been to a gym? Start here. Small groups and friendly coaches.',
    textKm: 'មិនដែលទៅកន្លែងហាត់ប្រាណទេ? ចាប់ផ្តើមនៅទីនេះ។ ក្រុមតូចៗ និងគ្រូបង្វឹករួសរាយ។',
  },
];

// TODO: change these to your gym's real facts.
const stats = [
  { value: '25 m', label: 'swimming pool', labelKm: 'អាងហែលទឹក' },
  { value: '6–21h', label: 'open every day', labelKm: 'បើករៀងរាល់ថ្ងៃ' },
  { value: 'Free', label: 'first class', labelKm: 'ថ្នាក់ដំបូងឥតគិតថ្លៃ' },
];

// Heart-rate zones from the simple rule: maximum ≈ 220 − age.
// Moderate = 50–70% of maximum, hard = 70–85%.
const zones = [20, 30, 40, 50, 60].map((age) => {
  const max = 220 - age;
  return {
    age,
    max,
    moderate: `${Math.round(max * 0.5)}–${Math.round(max * 0.7)}`,
    hard: `${Math.round(max * 0.7)}–${Math.round(max * 0.85)}`,
  };
});

const swimReasons = [
  {
    title: 'Works your whole body',
    titleKm: 'ធ្វើការទាំងខ្លួន',
    text: 'Arms, legs, and core all work together.',
    textKm: 'ដៃ ជើង និងពោះ ធ្វើការជាមួយគ្នា។',
  },
  {
    title: 'Easy on your joints',
    titleKm: 'ស្រាលលើសន្លាក់',
    text: 'The water holds you up, so it is gentle on your knees and back.',
    textKm: 'ទឹកទ្រទ្រង់ខ្លួនអ្នក ដូច្នេះវាស្រាលលើជង្គង់ និងខ្នង។',
  },
  {
    title: 'Strong heart and lungs',
    titleKm: 'បេះដូង និងសួតរឹងមាំ',
    text: 'Regular swimming helps your heart pump better.',
    textKm: 'ការហែលទឹកជាប្រចាំ ជួយឱ្យបេះដូងបូមឈាមបានល្អជាងមុន។',
  },
  {
    title: 'Keeps blood moving',
    titleKm: 'ធ្វើឱ្យឈាមរត់',
    text: 'Moving your legs helps your blood flow, which helps prevent clots.',
    textKm: 'ការធ្វើចលនាជើង ជួយឱ្យឈាមរត់ ដែលជួយការពារកំណកឈាម។',
  },
];

const clotTips = [
  {
    text: 'Get up and move every hour when you sit for a long time (work, bus, plane).',
    textKm: 'ក្រោកឈរ ហើយធ្វើចលនារៀងរាល់ម៉ោង ពេលអ្នកអង្គុយយូរ (ធ្វើការ ជិះឡានក្រុង ជិះយន្តហោះ)។',
  },
  {
    text: 'Exercise often. Walking and swimming are great.',
    textKm: 'ហាត់ប្រាណជាញឹកញាប់។ ការដើរ និងហែលទឹកល្អណាស់។',
  },
  { text: 'Drink enough water.', textKm: 'ផឹកទឹកឱ្យបានគ្រប់គ្រាន់។' },
  { text: 'Don’t smoke.', textKm: 'កុំជក់បារី។' },
];
---

<Base>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sun/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-brand/15 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-leaf"></span>
            Gym and swimming pool in Phnom Penh
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            Train your body. Protect your <span class="text-brand">heart.</span>
          </h1>
          <p lang="km" class="mt-4 text-xl text-ink/70">ហាត់ប្រាណរាងកាយ។ ការពារបេះដូង។</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            Lift weights, swim laps, and learn to train at the right heart rate. Our coaches help beginners start safely.
            <span class="km" lang="km">លើកទម្ងន់ ហែលទឹក និងរៀនហាត់ប្រាណតាមចង្វាក់បេះដូងដែលត្រឹមត្រូវ។ គ្រូបង្វឹករបស់យើងជួយអ្នកទើបចាប់ផ្តើម ឱ្យចាប់ផ្តើមដោយសុវត្ថិភាព។</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.telegram} class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              Message us on Telegram <span lang="km" class="font-khmer font-normal opacity-80">ផ្ញើសារ</span>
            </a>
            <a href="#train" class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              What we offer ↓ <span lang="km" class="font-khmer font-normal opacity-60">សេវាកម្ម</span>
            </a>
          </div>
        </div>

        <!-- Illustration: a heart-rate watch screen and a pool card -->
        <div class="relative" aria-hidden="true">
          <div class="rounded-3xl bg-ink p-6 text-paper shadow-2xl">
            <div class="flex items-center justify-between text-sm text-paper/60">
              <span>Heart rate</span>
              <span class="rounded-full bg-sun/20 px-2 py-0.5 text-sun">Cardio zone</span>
            </div>
            <p class="mt-3 flex items-baseline gap-2 font-display text-6xl font-extrabold">
              <span class="animate-pulse text-brand">♥</span> 128 <span class="text-lg font-semibold text-paper/60">bpm</span>
            </p>
            <svg viewBox="0 0 300 60" class="mt-4 w-full" fill="none">
              <path d="M0 30h70l10-18 14 40 14-34 10 12h52l10-18 14 40 14-34 10 12h72" stroke="#e11d48" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div class="relative -mt-6 mr-2 ml-auto w-60 rotate-[3deg] rounded-2xl border border-ink/10 bg-white p-4 shadow-xl sm:w-72">
            <div class="h-20 rounded-xl bg-gradient-to-br from-sun to-sky-700"></div>
            <p class="mt-3 font-display font-bold">🏊 Lap swim</p>
            <p class="text-xs text-muted">20 lengths · 500 m · 18 min</p>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="border-y border-ink/10 bg-white">
      <dl class="mx-auto grid max-w-6xl grid-cols-3 gap-6 px-4 py-10 sm:px-6">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-3xl font-extrabold text-brand sm:text-4xl">{s.value}</dd>
              <dd class="mt-1 text-sm text-muted">
                {s.label}
                <span class="km" lang="km">{s.labelKm}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- WHAT WE OFFER -->
    <section id="train" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">What we offer <span lang="km" class="font-khmer font-normal">· អ្វីដែលយើងផ្តល់ជូន</span></p>
      <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Everything you need to get strong.
      </h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">អ្វីៗទាំងអស់ដែលអ្នកត្រូវការ ដើម្បីរឹងមាំ។</p>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          offers.map((o) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6">
              <span class="text-3xl">{o.icon}</span>
              <h3 class="mt-4 font-display text-xl font-bold">
                {o.title}
                <span class="km text-base" lang="km">{o.titleKm}</span>
              </h3>
              <p class="mt-2 text-muted">
                {o.text}
                <span class="km" lang="km">{o.textKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- HEART RATE -->
    <section id="heart-rate" class="scroll-mt-20 bg-ink text-paper">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1fr_1.2fr]">
        <div>
          <p class="font-semibold text-brand">Heart rate <span lang="km" class="font-khmer font-normal">· ចង្វាក់បេះដូង</span></p>
          <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Know your heart rate.</h2>
          <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ស្គាល់ចង្វាក់បេះដូងរបស់អ្នក។</p>
          <p class="mt-6 text-lg text-paper/75">
            Your heart rate is how many times your heart beats in one minute (bpm). Most adults have a resting heart rate between 60 and 100 bpm.
            <span class="km" lang="km">ចង្វាក់បេះដូង គឺចំនួនដងដែលបេះដូងរបស់អ្នកលោតក្នុងមួយនាទី (bpm)។ មនុស្សពេញវ័យភាគច្រើន មានចង្វាក់បេះដូងពេលសម្រាក ចន្លោះពី ៦០ ទៅ ១០០ bpm។</span>
          </p>
          <p class="mt-4 text-lg text-paper/75">
            A simple way to guess your maximum: <strong class="text-paper">220 minus your age.</strong>
            <span class="km" lang="km">វិធីងាយស្រួលដើម្បីប៉ាន់ស្មានចង្វាក់អតិបរមា៖ ២២០ ដកអាយុរបស់អ្នក។</span>
          </p>
          <p class="mt-6 rounded-2xl border-l-4 border-sun bg-paper/5 p-4 text-paper/85">
            New to exercise? Stay in the moderate zone. If you feel chest pain, dizzy, or very short of breath, stop and rest.
            <span class="km" lang="km">ទើបចាប់ផ្តើមហាត់ប្រាណ? សូមនៅក្នុងកម្រិតមធ្យម។ បើអ្នកឈឺទ្រូង វិលមុខ ឬដកដង្ហើមមិនរួច សូមឈប់ ហើយសម្រាក។</span>
          </p>
        </div>

        <div class="overflow-hidden rounded-2xl bg-paper text-ink">
          <table class="w-full text-left">
            <thead class="bg-white text-sm">
              <tr>
                <th class="px-4 py-3">Age <span class="km" lang="km">អាយុ</span></th>
                <th class="px-4 py-3 text-leaf">Moderate <span class="km" lang="km">មធ្យម</span></th>
                <th class="px-4 py-3 text-brand">Hard <span class="km" lang="km">ខ្លាំង</span></th>
                <th class="px-4 py-3">Max <span class="km" lang="km">អតិបរមា</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink/10 font-display text-lg">
              {
                zones.map((z) => (
                  <tr>
                    <td class="px-4 py-3 font-bold">{z.age}</td>
                    <td class="px-4 py-3">{z.moderate}</td>
                    <td class="px-4 py-3">{z.hard}</td>
                    <td class="px-4 py-3 text-muted">{z.max}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="border-t border-ink/10 px-4 py-3 text-sm text-muted">
            Beats per minute. Moderate = 50–70% of max. Hard = 70–85% of max.
            <span class="km" lang="km">ចំនួនដងក្នុងមួយនាទី។ មធ្យម = ៥០–៧០% នៃអតិបរមា។ ខ្លាំង = ៧០–៨៥% នៃអតិបរមា។</span>
          </p>
        </div>
      </div>
    </section>

    <!-- SWIMMING -->
    <section id="swim" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-sun">Swimming <span lang="km" class="font-khmer font-normal">· ហែលទឹក</span></p>
      <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Why swimming is great for your heart.
      </h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ហេតុអ្វីការហែលទឹកល្អសម្រាប់បេះដូង។</p>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          swimReasons.map((r) => (
            <li class="rounded-2xl bg-sun/10 p-6">
              <span class="grid size-8 place-items-center rounded-full bg-sun text-sm font-bold text-paper">✓</span>
              <h3 class="mt-4 font-display text-lg font-bold">
                {r.title}
                <span class="km text-base" lang="km">{r.titleKm}</span>
              </h3>
              <p class="mt-1 text-muted">
                {r.text}
                <span class="km" lang="km">{r.textKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-muted">
        🛟 Never swim alone. Drink water, even in the pool.
        <span class="km" lang="km">កុំហែលទឹកតែម្នាក់ឯង។ ផឹកទឹក ទោះបីនៅក្នុងអាងហែលទឹកក៏ដោយ។</span>
      </p>
    </section>

    <!-- BLOOD CLOTS -->
    <section id="blood-clots" class="scroll-mt-20 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <p class="font-semibold text-brand">Health <span lang="km" class="font-khmer font-normal">· សុខភាព</span></p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Blood clots: what to know.</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">កំណកឈាម៖ អ្វីដែលត្រូវដឹង។</p>
        <p class="mt-6 max-w-3xl text-lg text-muted">
          A blood clot is a lump of blood that gets stuck in a vein. It often starts in the leg. If it moves to the lungs, it is an emergency.
          <span class="km" lang="km">កំណកឈាម គឺជាដុំឈាមដែលកកស្ទះនៅក្នុងសរសៃឈាម។ វាច្រើនចាប់ផ្តើមនៅជើង។ បើវារំកិលទៅសួត វាជាករណីបន្ទាន់។</span>
        </p>

        <div class="mt-12 grid gap-6 lg:grid-cols-2">
          <div class="rounded-2xl bg-leaf/10 p-6 sm:p-8">
            <h3 class="font-display text-2xl font-bold">
              Lower your risk
              <span class="km text-lg" lang="km">កាត់បន្ថយហានិភ័យ</span>
            </h3>
            <ul class="mt-6 space-y-4">
              {
                clotTips.map((t) => (
                  <li class="flex gap-3">
                    <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-leaf text-xs font-bold text-paper">✓</span>
                    <p>
                      {t.text}
                      <span class="km text-muted" lang="km">{t.textKm}</span>
                    </p>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="rounded-2xl bg-brand/10 p-6 sm:p-8">
            <h3 class="font-display text-2xl font-bold">
              Warning signs
              <span class="km text-lg" lang="km">សញ្ញាព្រមាន</span>
            </h3>
            <div class="mt-6 rounded-xl bg-white p-5">
              <p class="font-semibold">
                In one leg: swelling, pain, or warm, red skin
                <span class="km" lang="km">នៅជើងម្ខាង៖ ហើម ឈឺ ឬស្បែកក្តៅ និងក្រហម</span>
              </p>
              <p class="mt-2 text-muted">
                → See a doctor soon.
                <span class="km" lang="km">→ ទៅជួបគ្រូពេទ្យឱ្យបានឆាប់។</span>
              </p>
            </div>
            <div class="mt-4 rounded-xl bg-brand p-5 text-paper">
              <p class="font-semibold">
                Sudden shortness of breath, chest pain, or coughing up blood
                <span class="km" lang="km">ដកដង្ហើមមិនរួចភ្លាមៗ ឈឺទ្រូង ឬក្អកចេញឈាម</span>
              </p>
              <p class="mt-2 font-display text-2xl font-extrabold">
                → Call 119 now.
                <span class="km" lang="km">→ ហៅលេខ ១១៩ ភ្លាម។</span>
              </p>
            </div>
          </div>
        </div>

        <p class="mt-8 text-sm text-muted">
          This page is for learning only. It is not medical advice. Talk to a doctor about your health.
          <span class="km" lang="km">ទំព័រនេះសម្រាប់ការសិក្សាតែប៉ុណ្ណោះ។ វាមិនមែនជាដំបូន្មានវេជ្ជសាស្ត្រទេ។ សូមពិគ្រោះជាមួយគ្រូពេទ្យអំពីសុខភាពរបស់អ្នក។</span>
        </p>
      </div>
